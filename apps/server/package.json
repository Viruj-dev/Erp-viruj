{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/dev.ts --outfile server",
    "dev": "bun run --hot src/dev.ts",
    "start": "bun run dist/dev.mjs"
  },
  "dependencies": {
    "@erp_virujhealth/auth": "workspace:*",
    "@erp_virujhealth/db": "workspace:*",
    "@erp_virujhealth/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@erp_virujhealth/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^20",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
